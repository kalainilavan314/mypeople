[Unit]
Description=My People FastAPI service
After=network.target postgresql.service

[Service]
Type=simple
User=mypeople
WorkingDirectory=/srv/mypeople/services/api
EnvironmentFile=/srv/mypeople/services/api/.env
ExecStart=/srv/mypeople/services/api/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
