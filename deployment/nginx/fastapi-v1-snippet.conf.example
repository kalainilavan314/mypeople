# Drop-in Nginx snippet for FastAPI /v1 strangler proxy
# Server path: /etc/nginx/snippets/mypeople-fastapi-v1.conf
# Include inside /etc/nginx/sites-available/default server { ... } block:
#   include /etc/nginx/snippets/mypeople-fastapi-v1.conf;

# 1. Private Media & Evidence Isolation (Prevent static access; only authenticated streaming via API)
location ^~ /evidence/ {
    deny all;
    return 403;
}

location ^~ /private/ {
    deny all;
    return 403;
}

# 2. Fast Health Check (Fail-fast timeouts for probes)
location = /v1/health {
    proxy_pass http://127.0.0.1:8000/v1/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    access_log off;
}

# 3. Document and Media Uploads (15m proxy ceiling; FastAPI applies lower per-file limits)
location ~ ^/v1/(identity/me/documents(/|$)|content/albums/[^/]+/photos/?$) {
    client_max_body_size 15m;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# 4. Standard /v1/ API endpoints (2m body limit)
location /v1/ {
    client_max_body_size 2m;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}
