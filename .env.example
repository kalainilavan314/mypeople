# Copy to .env in the repository root for deployment/docker-compose.dev.yml.
# Never commit the real .env. Development values only.
#
# Each part of the project also has its own settings file:
#   server/.env                     Express API (live): DATABASE_URL, JWT_SECRET, NIC_PEPPER, ...
#   services/api/.env               FastAPI: see services/api/.env.example
#   apps/member-mobile/.env.local   EXPO_PUBLIC_API_URL (public address only, never a secret)
#   apps/staff-mobile/.env.local    EXPO_PUBLIC_API_URL
#   apps/admin-web/.env.local       API_URL (read on the server only)

# Password for the local PostgreSQL container.
POSTGRES_PASSWORD=

# For the API container (profile "api"). Long random values; generate each with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
NIC_PEPPER=

# 32 random bytes, base64. Generate with
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
EVIDENCE_ENCRYPTION_KEY=
