{
  "name": "@my-people/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed functions for the My People API (/v1), with types generated from its OpenAPI document",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
