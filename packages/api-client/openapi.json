          },
          "404": {
            "description": "not_found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "List Audit Entries",
        "description": "Audit entries, newest first (FR-ADM-011). A regional auditor sees only entries in their region.",
        "operationId": "list_audit_entries_v1_audit_get",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Actor Id"
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "name": "before_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "For paging: entries older than this id",
              "title": "Before Id"
            },
            "description": "For paging: entries older than this id"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntryOut"
                  },
                  "title": "Response List Audit Entries V1 Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit/verify": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Verify Audit Chain",
        "description": "Recompute the hash chain over the whole log. It spans every region, so it needs platform scope.",
        "operationId": "verify_audit_chain_v1_audit_verify_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainCheckOut"
                }
              }
            }
          },
          "403": {
            "description": "forbidden or platform_scope_required"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/identity/me/documents": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "List My Documents",
        "description": "Which identity images the server holds for the signed-in member (BR-020).\nMembers cannot download their images (BR-021, FR-PROF-007).",
        "operationId": "list_my_documents_v1_identity_me_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  },
                  "type": "array",
                  "title": "Response List My Documents V1 Identity Me Documents Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/identity/me/documents/{kind}": {
      "put": {
        "tags": [
          "identity"
        ],
        "summary": "Upload My Document",
        "description": "Upload or replace one identity image; the body is the image itself (FR-REG-004, 005, 010).\n\nThe response is the server's acknowledgement: only acknowledged images\ncount (BR-020), and the app deletes its own copy after it (FR-REG-035).",
        "operationId": "upload_my_document_v1_identity_me_documents__kind__put",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "nic_front",
                "nic_back",
                "passport_page",
                "selfie"
              ],
              "type": "string",
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "400": {
            "description": "empty_file"
          },
          "413": {
            "description": "too_large (over 10 MB)"
          },
          "415": {
            "description": "unsupported_type (JPEG, PNG or HEIC only)"
          },
          "503": {
            "description": "evidence_storage_not_configured"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/heic": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
