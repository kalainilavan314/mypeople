              "platform",
              "province",
              "district",
              "ds",
              "gn"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "level"
        ],
        "title": "AreaRef",
        "description": "An area: the whole platform, or a province, district, DS division or GN division by code."
      },
      "AssignmentInput": {
        "properties": {
          "memberId": {
            "type": "string",
