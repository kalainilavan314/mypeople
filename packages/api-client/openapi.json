        "type": "object",
        "required": [
          "allowed",
          "problems",
          "reviewDueAt"
        ],
        "title": "PreviewOut",
        "description": "What W09 shows before saving (RB-06). Each problem is a code the dashboard explains."
      },
      "RevokeInput": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RevokeInput"
      },
      "SignInRequest": {
        "properties": {
          "nic": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Nic"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "nic",
          "password"
        ],
        "title": "SignInRequest"
      },
      "SignInResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "member": {
            "$ref": "#/components/schemas/MemberProfile"
          }
        },
        "type": "object",
        "required": [
          "token",
          "member"
        ],
        "title": "SignInResponse",
        "description": "The token is returned for mobile apps; browsers use the HttpOnly cookie."
      },
      "TierInfo": {
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "1",
              "2A",
              "2B",
              "3A",
              "3B",
              "4",
              "5"
            ],
            "title": "Tier"
          },
          "areaLevel": {
            "type": "string",
            "enum": [
              "platform",
              "province",
              "district",
              "ds",
              "gn"
            ],
            "title": "Arealevel"
          },
          "defaultPermissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Defaultpermissions"
          }
        },
        "type": "object",
        "required": [
          "tier",
          "areaLevel",
          "defaultPermissions"
        ],
        "title": "TierInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "type": "apiKey",
        "description": "Session cookie set at sign-in (browsers).",
        "in": "cookie",
        "name": "mp_session"
      },
      "HTTPBearer": {
        "type": "http",
        "description": "The same session token, for mobile apps.",
        "scheme": "bearer"
      }
    }
  }
}
