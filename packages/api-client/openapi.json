        ],
        "summary": "List Member Documents",
        "description": "A member's current identity images, without the images. Needs members.view_identity_evidence\nover the member's area, and never for one's own record (BR-085).",
        "operationId": "list_member_documents_v1_identity_members__member_id__documents_get",
        "security": [
          {
