{
  "openapi": "3.1.0",
  "info": {
    "title": "My People API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check Health",
        "description": "Confirm the API process is running. This does not touch the database.",
        "operationId": "check_health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check Database",
        "description": "Confirm the API can run a query on PostgreSQL.",
        "operationId": "check_database_v1_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign In",
        "description": "Sign in with a NIC and password. Sets the session cookie and returns the token.",
        "operationId": "sign_in_v1_auth_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials"
          },
          "429": {
            "description": "too_many_attempts"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign Out",
        "description": "Sign out everywhere: every session token this member holds stops working.",
        "operationId": "sign_out_v1_auth_sign_out_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/members/me": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Read My Profile",
        "description": "The signed-in member's profile.",
        "operationId": "read_my_profile_v1_members_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberProfile"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus"
      },
      "MemberProfile": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "memberCode": {
            "type": "string",
            "title": "Membercode"
          },
          "fullName": {
            "type": "string",
            "title": "Fullname"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "dob": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "referralCode": {
            "type": "string",
            "title": "Referralcode"
          },
          "verificationStatus": {
            "type": "string",
            "title": "Verificationstatus"
          },
          "verifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verifiedat"
          },
          "districtCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Districtcode"
          },
          "districtName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Districtname"
          },
          "dsCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dscode"
          },
          "dsName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dsname"
          },
          "gsCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gscode"
          },
          "gsName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gsname"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Joinedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "memberCode",
          "fullName",
          "phone",
          "dob",
          "gender",
          "language",
          "tier",
          "referralCode",
          "verificationStatus",
          "verifiedAt",
          "districtCode",
          "districtName",
          "dsCode",
          "dsName",
          "gsCode",
          "gsName",
          "joinedAt"
        ],
        "title": "MemberProfile",
        "description": "The signed-in member's own profile.\n\nJSON keys are camelCase, matching the Express /api/me response. The NIC\nhash, password hash and staff-only review fields are never part of it."
      },
      "SignInRequest": {
        "properties": {
          "nic": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Nic"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "nic",
          "password"
        ],
        "title": "SignInRequest"
      },
      "SignInResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "member": {
            "$ref": "#/components/schemas/MemberProfile"
          }
        },
        "type": "object",
        "required": [
          "token",
          "member"
        ],
        "title": "SignInResponse",
        "description": "The token is returned for mobile apps; browsers use the HttpOnly cookie."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "type": "apiKey",
        "description": "Session cookie set at sign-in (browsers).",
        "in": "cookie",
        "name": "mp_session"
      },
      "HTTPBearer": {
        "type": "http",
        "description": "The same session token, for mobile apps.",
        "scheme": "bearer"
      }
    }
  }
}
