              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  },
                  "title": "Response List Member Documents V1 Identity Members  Member Id  Documents Get"
                }
              }
            }
          },
          "403": {
            "description": "forbidden, own_record, outside_your_area, link_expired, link_invalid or link_not_yours"
