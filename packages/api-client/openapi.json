  "components": {
    "schemas": {
      "AreaRef": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "platform",
              "province",
              "district",
              "ds",
              "gn"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "level"
        ],
        "title": "AreaRef",
        "description": "An area: the whole platform, or a province, district, DS division or GN division by code."
      },
      "AssignmentInput": {
        "properties": {
          "memberId": {
            "type": "string",
            "format": "uuid",
            "title": "Memberid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "1",
              "2A",
              "2B",
              "3A",
              "3B",
              "4",
              "5"
            ],
            "title": "Tier"
          },
          "area": {
            "$ref": "#/components/schemas/AreaRef"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 60,
            "title": "Permissions"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "memberId",
          "tier",
          "area",
          "permissions"
        ],
        "title": "AssignmentInput"
      },
      "AssignmentOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "memberId": {
            "type": "string",
            "format": "uuid",
            "title": "Memberid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "1",
              "2A",
              "2B",
              "3A",
              "3B",
              "4",
              "5"
            ],
            "title": "Tier"
          },
          "area": {
            "$ref": "#/components/schemas/AreaRef"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ],
            "title": "State"
          },
          "grantedBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grantedby"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Grantedat"
          },
          "reviewDueAt": {
            "anyOf": [
              {
                "type": "string",
