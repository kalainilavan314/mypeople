# Copy to .env for local development. In a deployment these are set as the
# host's environment variables instead — never commit real values.

# --- Required ---------------------------------------------------------------
# Postgres. Local dev uses a plain connection; a managed provider (Supabase,
# Neon) supplies a URL that ends in ?sslmode=require — TLS is enabled
# automatically for any non-localhost host (see src/db.js).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/northern_province

# Signs session tokens. Any long random string; changing it logs everyone out.
JWT_SECRET=change-me-to-something-long-and-random

# Salt for NIC hashes. CHANGING THIS INVALIDATES EVERY STORED NIC HASH — nobody
# can log in afterwards. Set it once, back it up, never rotate it casually.
NIC_PEPPER=change-me-and-never-change-again

# --- Runtime ----------------------------------------------------------------
# development | production. Production enables boot-time secret checks and
# disables development OTP disclosure.
NODE_ENV=development

PORT=8787

# Comma-separated browser origins allowed to call this API. The single-service
# deployment serves its own PWA and can leave this empty.
ALLOWED_ORIGINS=

# Maximum JSON/request body accepted by Express. The default is 8mb on a
# long-running host and 4mb on serverless platforms.
MAX_BODY=8mb

# --- File storage -----------------------------------------------------------
# Unset: avatars and donation slips are written to server/uploads/. Correct for
# local dev, and WRONG for any host with an ephemeral disk (Render free, Fly,
# most PaaS free tiers), where uploads vanish on each deploy and sleep/wake.
# Set both to store them in Supabase Storage instead. Use the service_role key
# — it is server-side only and must never reach the browser.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key from Project Settings -> API>
# SUPABASE_BUCKET=npm-uploads

# --- Development only -------------------------------------------------------
# Returns OTP codes in API responses so the flow is testable without an SMS
# gateway. Ignored in production; never enable it on a reachable deployment.
DEV_OTP=true

# Development renders sandbox membership cards. Keep false in production;
# enable only when a controlled non-production environment needs them.
ALLOW_SANDBOX_CARD=false

# Escape hatch: skip TLS certificate verification for Postgres. Only if the
# connection fails without it — it keeps encryption but stops authenticating
# the server, and this database holds NIC hashes.
# PGSSL_INSECURE=true

# Optional PEM CA override for a managed PostgreSQL provider. Leave unset to
# use the bundled Supabase root CA/default trust path.
# PGSSL_CA="-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----"

# Connections this instance may open. The database enforces one ceiling across
# ALL instances, so this is per-instance and deliberately small: Supabase's
# shared pooler allows 15 in session mode, and two instances at 10 already
# exceed it. Raise it once the database is co-located and its own
# max_connections is known.
PG_POOL_MAX=4

# Milliseconds before an idle connection is released, and before a new
# connection attempt fails.
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=20000
