# Copy to services/api/.env for local settings. Never commit the real .env.

# development | staging | production. Production hides /docs and /openapi.json.
APP_ENV=development

# Required. The same PostgreSQL URL the Express API uses (server/.env).
# postgres:// and postgresql:// both work; add ?sslmode=require for remote hosts.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Required. Must be the same value as JWT_SECRET in server/.env, so sessions
# from either API work in both. Use a long random value (at least 32 bytes).
JWT_SECRET=

# Required. Must be the same value as NIC_PEPPER in server/.env, or no existing
# member can sign in. Never change it once members have registered.
NIC_PEPPER=

# Optional. Other origins allowed to send cookie-authenticated writes
# (comma-separated), as ALLOWED_ORIGINS in server/.env. Empty = same origin only.
ALLOWED_ORIGINS=

# Staff give an authenticator code in each session (NFR-SEC-04). Only
# development may switch it off.
STAFF_MFA_REQUIRED=true

# How one-time codes are sent: none (default, answers 503) or development
# (codes kept in memory and returned in responses; development only).
SMS_PROVIDER=development
# Notify.lk (SMS_PROVIDER=notify_lk): the User ID and API Key from app.notify.lk > Settings, and the
# approved sender ID. NotifyDEMO is for tests only and is refused in production. Put the real
# values only in the server's settings file, never in the repository or in chat.
# NOTIFY_LK_USER_ID=
# NOTIFY_LK_API_KEY=
# NOTIFY_LK_SENDER_ID=

# Push notifications: none keeps notices in the in-app inbox. Development
# keeps pushes in memory and is refused outside APP_ENV=development.
PUSH_PROVIDER=none

# v1.1 modules stay off until their phase gate is recorded. Production always
# enforces gates; local development normally leaves this false.
ENFORCE_FEATURE_FLAGS=false

# Passport format accepted at registration. Sponsor policy may replace this
# expression; keep it anchored and test any change before deployment.
PASSPORT_NUMBER_PATTERN=^[A-Z0-9]{6,9}$

# Identity evidence (NIC images, selfies). Optional: without them the identity
# document endpoints answer 503. Set both or neither.
# A private directory outside any web root; in production on the encrypted
# /srv/secure volume, readable only by the API's own user.
# EVIDENCE_STORAGE_DIR=
# 32 random bytes, base64-encoded. Generate one with
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# and keep a copy apart from the files: without it no stored image can be read.
# EVIDENCE_ENCRYPTION_KEY=

# Gallery photos, stored as WebP files without metadata. Optional: without it
# the gallery's photo endpoints answer 503. Include it in backups.
# MEDIA_STORAGE_DIR=

# Community Finance (M1.4 bank slip intake & reconciliation).
# Kept disabled by default; fails closed with 503 when intake is disabled.
# FINANCE_INTAKE_ENABLED=false
# FINANCE_BANK_NAME=Bank of Ceylon
# FINANCE_ACCOUNT_NAME=My People Party Fund
# FINANCE_ACCOUNT_NUMBER=000123456789
# FINANCE_BRANCH_NAME=Jaffna Main Branch
# FINANCE_TRANSFER_INSTRUCTIONS_EN="Please use direct bank transfer only. Enter your donor reference in the bank transfer note."
# FINANCE_TRANSFER_INSTRUCTIONS_TA="நேரடி வங்கிப் பரிமாற்றத்தை மட்டும் பயன்படுத்தவும். பரிமாற்றக் குறிப்பில் உங்கள் குறிப்பு எண்ணை உள்ளிடவும்."
# Separate 32-byte base64 encryption key for finance transfer slips (falls back to EVIDENCE_ENCRYPTION_KEY if unset).
# FINANCE_ENCRYPTION_KEY=
# Malware scanner mode: development for local EICAR checks; clamav is required when live intake is enabled outside development.
# FINANCE_MALWARE_SCANNER=development
# FINANCE_CLAMAV_HOST=127.0.0.1
# FINANCE_CLAMAV_PORT=3310
# FINANCE_CLAMAV_TIMEOUT_SECONDS=10
# Development fallback only; staging/production uses the current approved FIN-01 control.
# FINANCE_INTERNAL_REVIEW_THRESHOLD_MINOR=10000000

# The member app's public address; invitation links point to <address>/join/<token>.
MEMBER_APP_URL=https://app.tmk.lk
