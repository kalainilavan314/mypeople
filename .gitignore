# Dependencies
node_modules/

# Build output
app/dist/
app/dev-dist/

# Python (services/*): virtual environments, bytecode, test and build caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Secrets — DATABASE_URL, JWT_SECRET, NIC_PEPPER, invite codes.
# Never commit these: NIC_PEPPER in particular is the salt protecting every
# stored NIC hash. Deployment secrets belong in the host's env-var settings.
.env
.env.*
!.env.example

# Locally stored uploads (avatars, donation slips). Member data — and in a
# deployed environment these live in object storage, not in the repo.
server/uploads/

# Local-only audit/review notes — not meant to be pushed or shared on branches.
# Anchored to the root: services/api/app/modules/audit/ is code and is tracked.
/audit/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Local deployment packages and fetched reference bundles.
deployment/artifacts/
deployment/reference*
deployment/outfit-font.css
deployment/.ssh-runtime/
design/qa/overflow.png
