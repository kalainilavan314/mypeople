# Copy to .env.local. EXPO_PUBLIC_ variables are built into the app and are
# readable by anyone who has it: put only the public API address here, never a
# password, token or key.
#
# Web/Android emulator: http://localhost:8000
# Physical phone: replace the example LAN address with this computer's IPv4
# address and run Uvicorn with --host 0.0.0.0.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
