{
  "expo": {
    "name": "TMK",
    "slug": "my-people-member",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "mypeople",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "lk.mypeople.member",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TMK uses the camera to photograph your ID and take a selfie for identity verification, proof of residence for an area change, and, for staff, to scan event passes and membership cards at check-in.",
          "photosPermission": "TMK lets you choose a photo of your ID or proof of residence when you cannot use the camera.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "TMK uses the camera to photograph your ID and take a selfie for identity verification, proof of residence for an area change, and, for staff, to scan event passes and membership cards at check-in.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
